---
// ─── A2A Leaderboard Widget ───────────────────────────────────────────────────
//
// Static build-time widget showing top-10 A2A trust scores.
// Data fetched in index.astro frontmatter — no client-side JS.
// Designed for social proof between Hero and Features sections.

interface LeaderboardEntry {
  name: string;
  url: string;
  score: number;
  grade: string;
  layers: { l1: number; l2: number; l3: number; l4: number };
  ts: string;
}

interface Props {
  entries: LeaderboardEntry[];
  total: number;
}

const { entries, total } = Astro.props;

function formatDate(ts: string): string {
  try {
    const d = new Date(ts);
    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  } catch {
    return '';
  }
}

function gradeColorClass(grade: string): string {
  switch (grade) {
    case 'S': return 'text-blue-600 dark:text-blue-400';
    case 'A': return 'text-green-600 dark:text-green-400';
    case 'B': return 'text-green-500 dark:text-green-400';
    case 'C': return 'text-yellow-600 dark:text-yellow-400';
    case 'D': return 'text-orange-500 dark:text-orange-400';
    case 'F': return 'text-red-500 dark:text-red-400';
    default:  return 'text-muted-foreground';
  }
}

const topScore = entries[0]?.score ?? 0;
const hasData = entries.length > 0;
---

<section class="max-w-5xl mx-auto px-4 py-12">
  <div class="mb-5">
    <h2 class="text-2xl font-bold tracking-tight">Top agents this week</h2>
    {hasData ? (
      <p class="mt-2 text-sm text-muted-foreground max-w-2xl">
        {total} agents in the directory. Every one scores 0 on behavioral trust (L4).
        The top scorer hit {topScore}/100 by having a well-formed AgentCard and a working A2A endpoint.
        Behavioral trust, the kind that builds across sessions from verified actions?
        Zero, universally. That's the problem AgentLair was built to fix.
      </p>
    ) : (
      <p class="mt-2 text-sm text-muted-foreground">Leaderboard refreshing — check back shortly.</p>
    )}
  </div>

  {hasData && (
    <div class="overflow-x-auto rounded-lg border border-border">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-border bg-muted/50">
            <th class="w-10 px-4 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wide">#</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wide">Agent</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-muted-foreground uppercase tracking-wide">Score</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-muted-foreground uppercase tracking-wide hidden sm:table-cell">Audited</th>
          </tr>
        </thead>
        <tbody>
          {entries.map((entry, i) => (
            <tr class="border-b border-border last:border-0 hover:bg-muted/30 transition-colors">
              <td class="px-4 py-3 text-muted-foreground font-mono text-xs tabular-nums">{i + 1}</td>
              <td class="px-4 py-3">
                <a
                  href={entry.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-medium hover:text-primary transition-colors line-clamp-1"
                >
                  {entry.name}
                </a>
              </td>
              <td class="px-4 py-3 text-right tabular-nums">
                <span class={`font-bold ${gradeColorClass(entry.grade)}`}>{entry.score}</span>
              </td>
              <td class="px-4 py-3 text-right text-muted-foreground text-xs tabular-nums hidden sm:table-cell">
                {formatDate(entry.ts)}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  <p class="mt-3 text-xs text-muted-foreground">
    <a
      href="https://agentlair.dev/leaderboard/a2a"
      class="hover:text-foreground transition-colors"
    >
      Full results at agentlair.dev/leaderboard/a2a ({total} agents) &rarr;
    </a>
  </p>
  <p class="mt-3 text-xs text-muted-foreground">
    Not yet ranked. <a href="/a2a-audit" class="hover:text-foreground transition-colors underline">Run the free 4-layer A2A audit</a> — behavioral trust, endpoint verification, and AgentCard compliance scored end-to-end. Under 3 minutes.
  </p>
</section>
