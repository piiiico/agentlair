---
import { getCollection } from 'astro:content';
import BaseHead from '@/components/BaseHead.astro';
import { Navbar } from '@/components/blocks/navbar';
import { Footer } from '@/components/blocks/footer';
import { BlogPosts } from '@/components/blocks/blog-posts';

// Hide posts whose pubDate is in the future. Future-dated frontmatter
// (intentional schedule or accidental typo) was leaking into the listing
// without this filter — see audit 2026-05-04. The slug route applies the
// same gate in getStaticPaths so direct URLs 404 until the publish date.
const now = new Date();
const posts = (await getCollection('blog'))
  .filter((p) => p.data.pubDate.valueOf() <= now.valueOf())
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<html lang="en">
  <head>
    <BaseHead
      title="Blog | AgentLair"
      description="Insights on AI agent infrastructure, security, and the future of autonomous systems."
    />
  </head>
  <body class="h-screen antialiased">
    <Navbar client:only="react" />
    <main class="pt-32 pb-20">
      <BlogPosts posts={posts} client:load />
    </main>
    <Footer />
  </body>
</html>
