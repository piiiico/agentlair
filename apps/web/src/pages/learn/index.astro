---
import { getCollection } from 'astro:content';
import BaseHead from '@/components/BaseHead.astro';
import { Navbar } from '@/components/blocks/navbar';
import { Footer } from '@/components/blocks/footer';

const pages = (await getCollection('learn'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<html lang="en">
  <head>
    <BaseHead
      title="Learn | AgentLair"
      description="Technical deep-dives on agent identity, behavioral attestation, and trust infrastructure."
    />
  </head>
  <body class="h-screen antialiased">
    <Navbar client:only="react" />
    <main class="pt-32 pb-20">
      <section class="mx-auto max-w-3xl px-4">
        <h1 class="text-3xl font-bold tracking-tight mb-4">Learn</h1>
        <p class="text-lg text-muted-foreground mb-12">
          Technical deep-dives on agent identity, behavioral attestation, and trust infrastructure.
        </p>
        <div class="space-y-8">
          {pages.map((page) => (
            <a href={`/learn/${page.id}`} class="block group">
              <article class="border-b pb-8">
                <p class="text-sm text-muted-foreground mb-1">
                  {page.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </p>
                <h2 class="text-xl font-semibold group-hover:text-primary transition-colors mb-2">
                  {page.data.title}
                </h2>
                <p class="text-muted-foreground">{page.data.description}</p>
              </article>
            </a>
          ))}
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
