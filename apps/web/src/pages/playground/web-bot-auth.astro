---
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import { WebBotAuthPlaygroundWidget } from '@/components/playground/WebBotAuthPlaygroundWidget';
---
<DefaultLayout
  title='Web Bot Auth Playground — AgentLair'
  description='Sign and verify HTTP requests per RFC 9421 — interactive demo with L3 cryptographic verdict and L4 behavioral attestation chain.'
>
  <main class='min-h-screen pt-24 pb-16'>
    <div class='mx-auto max-w-4xl px-5'>
      <header class='mb-8'>
        <p class='text-primary mb-2 font-mono text-sm font-medium'>Playground</p>
        <h1 class='font-display mb-3 text-3xl font-bold tracking-tight lg:text-4xl'>
          Web Bot Auth — interactive
        </h1>
        <p class='text-muted-foreground max-w-2xl text-base leading-relaxed'>
          Generate an Ed25519 keypair in your browser, register it anonymously, sign an HTTP request per RFC 9421, then verify the signature and see the L3 cryptographic verdict alongside AgentLair's L4 behavioral attestation chain.
        </p>
        <p class='text-muted-foreground/70 mt-2 max-w-2xl text-sm'>
          Demo only. Keypairs are ephemeral — generated in this page session and never stored. Do not use these signatures for production traffic.
        </p>
      </header>
      <noscript>
        <div class='border-destructive/40 bg-destructive/5 mb-6 rounded-lg border p-4 text-sm'>
          This playground requires JavaScript. The underlying API is at <code>POST /v1/wba/verify</code> — see <a class='underline' href='/docs/web-bot-auth'>the docs</a> for how to call it from any HTTP client.
        </div>
      </noscript>
      <WebBotAuthPlaygroundWidget client:load />
    </div>
  </main>
</DefaultLayout>
