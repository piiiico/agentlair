---
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

import { Background } from '@/components/background';
import { Pricing } from '@/components/blocks/pricing';
import { PricingTable } from '@/components/blocks/pricing-table';
import { X402Callout } from '@/components/blocks/x402-callout';
import DefaultLayout from '@/layouts/DefaultLayout.astro';
---
<DefaultLayout
  title="Pricing — AgentLair"
  description="Start free with 3 agents and 1,000 verifications/month. Scale to Starter ($29), Pro ($149), or Enterprise for cross-org behavioral trust scoring."
>
  <Background>
    <Pricing client:only='react' className="py-28 text-center lg:pt-44 lg:pb-32" />
    <X402Callout />
    <PricingTable client:only='react' />
  </Background>
</DefaultLayout>
