{
  "name": "@agentlair/sdk",
  "version": "0.4.0",
  "description": "Official TypeScript/JavaScript SDK for AgentLair — email, vault, behavioral events, trust scores, and account management for AI agents. Zero dependencies. Works in Node, Bun, Deno, and browsers.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "agentlair",
    "ai-agent",
    "email",
    "vault",
    "events",
    "trust",
    "behavioral-trust",
    "sdk",
    "typescript"
  ],
  "author": "AgentLair",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/piiiico/agentlair"
  },
  "homepage": "https://agentlair.dev",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
